# ──────────────────────────────────────────────────────────────────────────────
# EcoBrew environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────────────────────

# --- Public values (safe for the browser) ---
# Supabase project URL and the anon/publishable key (public by design).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Public origin of the deployed app; used to build the OAuth redirect_to URL.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Server-only secrets (never expose these to the browser) ---
# Series the httpOnly ecobrew_session / ecobrew_account / ecobrew_admin cookies.
# Generate with: openssl rand -base64 36
ECOBREW_SESSION_SECRET=CHANGE_ME_MIN_16_CHARS

# Supabase service_role key. BYPASSES ROW LEVEL SECURITY — use ONLY inside
# server route handlers that have already authenticated the caller (admin
# cookie or account/Google session). From Supabase Dashboard → Settings →
# API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Admin password, stored ONLY as an scrypt hash (Node crypto, no dependencies).
# There is no default and no plaintext copy — if this is unset the admin panel
# fails closed. Generate:
#   node -e "const{scryptSync,randomBytes}=require('crypto');const s=randomBytes(16).toString('base64');const h=scryptSync(process.argv[1],s,64).toString('base64');console.log('scrypt:'+s+':'+h)" 'your-password'
ADMIN_PASSWORD_HASH=scrypt:SALT_BASE64:KEY_BASE64
