# Supabase (public values — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Signs the server-side ecobrew_session cookie. Generate with: openssl rand -base64 36
ECOBREW_SESSION_SECRET=CHANGE_ME_MIN_16_CHARS

# Public origin of the deployed app; used to build the OAuth redirect_to URL.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
